# Auto normalize line endings
* text=auto

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary

# Cross-platform text files
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
LICENSE  text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Source code
*.py     text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.sh     text eol=lf

# .NET / C# source files
*.cs      diff=csharp text eol=crlf
*.xaml    text eol=crlf
*.xaml.cs text eol=crlf
*.sln     text eol=crlf
*.csproj  text eol=crlf

# Windows Setup scripts
*.iss text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf